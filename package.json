    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "drizzle-orm": "0.45.2",
    "mysql2": "3.24.4",
    "next": "16.2.6",
    "posthog-js": "^1.434.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6"
  },
  "type": "module"
