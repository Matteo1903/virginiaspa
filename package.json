  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test": "npm run build && node --test tests/ritual-catalog.test.mjs tests/db-errors.test.mjs tests/hostinger-runtime.test.mjs tests/mysql-schema.test.mjs tests/site-http.test.mjs",
